{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!public/**/*.js"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none"
		}
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"semicolons": "asNeeded",
			"arrowParentheses": "always",
			"trailingCommas": "es5"
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentWidth": 2,
			"indentStyle": "space"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"useSortedProperties": "on"
			}
		}
	},
	"plugins": [
		{
			"path": "./biome/no-markup-locator.grit",
			"includes": ["e2e/**/*.ts"]
		}
	]
}
