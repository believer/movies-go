package list

import "believer/movies/utils"

templ dt(text, id string) {
	<dt class="dt" id={ id }>
		{ text }
	</dt>
}

templ dd(labelID string, isTabular bool) {
	<dd class={ "dd", templ.KV("dd--tabular", isTabular) } aria-labelledby={ labelID }>
		{ children... }
	</dd>
}

templ Dl() {
	<dl class="description-list">
		{ children... }
	</dl>
}

type DlProps struct {
	ID        string
	Detail    string
	IsTabular bool
	IsColumn  bool
}

// labelID is the id of the item's <dt>, which labels its <dd>. It differs
// from ID, which htmx targets on the wrapper.
func (p DlProps) labelID() string {
	if p.ID != "" {
		return p.ID + "-label"
	}

	return "dl-" + utils.Slugify(p.Detail)
}

templ DlItem(props DlProps) {
	<div
		class="contents"
		if props.ID != "" {
			id={ props.ID }
		}
		if props.IsColumn {
			style="--style:column;--align:flex-start;--spacing:var(--spacing-1);"
		}
	>
		@dt(props.Detail, props.labelID())
		@dd(props.labelID(), props.IsTabular) {
			{ children... }
		}
	</div>
}
